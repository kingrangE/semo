# Copy to .env and set a local database password before starting Docker Compose.
POSTGRES_PASSWORD=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna

# Opt in to exporting questions, retrieved content and answers to Langfuse.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
